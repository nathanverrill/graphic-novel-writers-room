# Defaults for every agent. Each role can override any of these in
# agents/<agent>/agent.json (see README "Per-agent settings").

# Any OpenAI-compatible endpoint. Include the version path.
#   OpenAI      https://api.openai.com/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Ollama      http://localhost:11434/v1
#   LM Studio   http://localhost:1234/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Optional. Blank = don't send (some reasoning models reject temperature).
OPENAI_TEMPERATURE=
OPENAI_MAX_TOKENS=
OPENAI_TIMEOUT=300
# Send reference images to the model (needs a vision-capable model)
SEND_IMAGES=true
# Max model calls per agent turn
AGENT_MAX_STEPS=12
# How reference .md files reach agents: "full" = pasted into every prompt,
# "list" = names only, agents read what they need (cheaper for big scripts).
# A role can override this, and can name its own shortlist of library files
# ("references" and "reference_files" in agents/<id>/agent.json).
REFERENCES_MODE=full

# Image generation, used by roles with "generate_images": true.
# Blank IMAGE_MODEL = no images unless a role's agent.json names one.
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1024x1024
# Only if images come from a different host than chat:
IMAGE_BASE_URL=
IMAGE_API_KEY=

# Keys for other providers, referenced by name from agent.json ("api_key_env")
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=

# ASCII page previews: one character cell = one letter of lettering at this size.
# 7.5 pt lettering on a 6.625x10.25" page gives a 116x82-cell page.
LETTERING_PT=7.5
PAGE_TRIM=6.625x10.25

# Object store for project data (docker-compose runs SeaweedFS and sets S3_ENDPOINT
# for the app). Set these to change the credentials; leave S3_ENDPOINT unset to keep
# data as plain files when running without Docker.
# S3_ENDPOINT=http://localhost:8333
S3_BUCKET=writers-room
S3_ACCESS_KEY=writers-room
S3_SECRET_KEY=change-me
S3_SYNC_SECONDS=2

# Personal access token for Figma links in figma.txt
FIGMA_TOKEN=
